# 采集总开关：false 时三个采集端点返回成功但零落库（AC-09，默认关闭）
COLLECTION_ENABLED=false

# 服务端口
PORT=3000

# SQLite 单文件路径（相对 cwd 或绝对路径）
DB_PATH=./data/scc.db

# 管理员端点令牌（X-Admin-Token）。留空则 admin 端点一律 401
ADMIN_TOKEN=

# 联系方式加密密钥（followups 表）。留空则 /followups 返回 5001
CONTACT_ENCRYPTION_KEY=

# 知情同意文本版本与方式
CONSENT_VERSION=v1.0-2026-09
CONSENT_MODE=implied

# 允许的前端来源，逗号分隔。生产环境禁止使用通配
CORS_ORIGINS=http://localhost:5173

# 作答过快阈值（毫秒），低于此值打 rapid 标记
RAPID_FLAG_THRESHOLD_MS=12000
